import React, { useState } from 'react';
import { 
  GraduationCap, Calendar, Clock, BookOpen, CheckCircle2, 
  Circle, Plus, MapPin, Trash2, Cloud, LayoutGrid, FileText
} from 'lucide-react';
import { SchoolClass, Assignment, SchoolGradesData } from '../types';
import { getRelativeDateString } from '../hooks/useAppState';

export function SchoolScheduleView({ state }: { state: any }) {
  const [activeSubTab, setActiveSubTab] = useState<'deberes' | 'horario' | 'boletin'>('deberes');
  
  // States Deberes
  const [showSchoolAccessModal, setShowSchoolAccessModal] = useState(false);
  const [saUser, setSaUser] = useState('');
  const [saPass, setSaPass] = useState('');
  const [syncRange, setSyncRange] = useState<'semana' | 'mes' | 'año'>('semana');
  const [saSyncDate, setSaSyncDate] = useState(getRelativeDateString(0));
  const [saLoading, setSaLoading] = useState(false);
  const [saError, setSaError] = useState('');

  const [dateFilter, setDateFilter] = useState<'proximos' | 'todos'>('proximos');
  const assignments: Assignment[] = state.assignments || [];
  const schoolClasses: SchoolClass[] = state.schoolClasses || [];
  const grades: SchoolGradesData = state.gradesData || { grades: [], habits: [], attendance: [], observations: [] };

  const handleSyncSchoolAccess = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!saUser || !saPass) return;
    setSaLoading(true); setSaError('');

    try {
      const selectedDate = new Date(`${saSyncDate}T12:00:00`);
      let monday = new Date(selectedDate);
      let friday = new Date(selectedDate);

      if (syncRange === 'semana') {
        const diffToMonday = selectedDate.getDay() === 0 ? -6 : 1 - selectedDate.getDay();
        monday.setDate(selectedDate.getDate() + diffToMonday);
        friday.setDate(monday.getDate() + 4);
      } else if (syncRange === 'mes') {
        monday = new Date(selectedDate.getFullYear(), selectedDate.getMonth(), 1);
        friday = new Date(selectedDate.getFullYear(), selectedDate.getMonth() + 1, 0);
      } else { // Todo el año
        monday = new Date(selectedDate.getFullYear(), 0, 1);
        friday = new Date(selectedDate.getFullYear(), 11, 31);
      }

      const formatIso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      
      const loginRes = await fetch('/api/school/login', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username: saUser, password: saPass })
      });
      const loginData = await loginRes.json();
      if (!loginData.success) throw new Error(loginData.error);

      // Sincronizar Deberes
      const assignRes = await fetch(`/api/school/assignments?startDate=${formatIso(monday)}&endDate=${formatIso(friday)}`);
      const assignData = await assignRes.json();
      
      if (assignData.success && Array.isArray(assignData.data)) {
        assignData.data.forEach((item: any) => {
          if (item.title) {
            state.addAssignment({
              title: item.title, subject: item.subject, dueDate: item.dueDate,
              priority: item.priority || 'Media', notes: item.notes
            });
          }
        });
      }

      // Sincronizar Horario y Boletín si el usuario lo desea, podemos llamarlos aquí también
      const schedRes = await fetch('/api/school/schedule');
      const schedData = await schedRes.json();
      if (schedData.success && state.updateSchoolClasses) {
        state.updateSchoolClasses(schedData.data);
      }

      const gradeRes = await fetch('/api/school/grades');
      const gradeData = await gradeRes.json();
      if (gradeData.success && state.updateGradesData) {
        state.updateGradesData(gradeData.data);
      }

      setSaLoading(false);
      setShowSchoolAccessModal(false);
      alert('¡Sincronización completa desde SchoolAccess!');
    } catch (err: any) {
      setSaLoading(false); setSaError(err.message);
    }
  };

  const filteredAssignments = dateFilter === 'todos' 
    ? assignments 
    : assignments.filter(a => !a.completed);

  return (
    <div className="p-4 md:p-8 space-y-6 max-w-5xl mx-auto pb-28 md:pb-12">
      {/* Header */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 className="text-2xl md:text-3xl font-black text-slate-900 flex items-center gap-2">
            Portal Escolar Integrado
          </h1>
          <p className="text-slate-500 text-sm mt-0.5">Deberes, Horario Oficial y Calificaciones</p>
        </div>
        <button
          onClick={() => setShowSchoolAccessModal(true)}
          className="bg-sky-600 hover:bg-sky-700 text-white font-bold text-sm px-4 py-2.5 rounded-2xl shadow-sm transition-all flex items-center gap-2"
        >
          <Cloud size={18} /> Sincronizar SchoolAccess
        </button>
      </div>

      {/* Tabs */}
      <div className="flex items-center gap-2 border-b border-slate-200 pb-3 overflow-x-auto">
        <button onClick={() => setActiveSubTab('deberes')} className={`px-4 py-2 rounded-xl text-sm font-bold flex items-center gap-2 ${activeSubTab === 'deberes' ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}`}>
          <BookOpen size={16} /> Deberes y Tareas
        </button>
        <button onClick={() => setActiveSubTab('horario')} className={`px-4 py-2 rounded-xl text-sm font-bold flex items-center gap-2 ${activeSubTab === 'horario' ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}`}>
          <LayoutGrid size={16} /> Horario Oficial
        </button>
        <button onClick={() => setActiveSubTab('boletin')} className={`px-4 py-2 rounded-xl text-sm font-bold flex items-center gap-2 ${activeSubTab === 'boletin' ? 'bg-indigo-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}`}>
          <FileText size={16} /> Boletín
        </button>
      </div>

      {/* TAB: DEBERES */}
      {activeSubTab === 'deberes' && (
        <div className="space-y-4 bg-white p-5 rounded-3xl border border-slate-200 shadow-sm">
          <div className="flex justify-between items-center">
            <h2 className="text-lg font-black text-slate-900">Lista de Deberes</h2>
            <div className="flex gap-2">
