          <h2 className="text-lg font-black text-slate-900">Boletín de Calificaciones</h2>
          {grades.grades.length === 0 ? <p className="text-sm text-slate-500">Sincroniza para ver calificaciones.</p> : (
            <table className="w-full text-left text-sm">
              <thead className="bg-slate-50 text-slate-500 font-bold">
                <tr><th className="p-2 rounded-l-lg">Materia</th><th className="p-2">Trim 1</th><th className="p-2">Trim 2</th><th className="p-2">Trim 3</th><th className="p-2 rounded-r-lg">Final</th></tr>
