              <tbody>
                {grades.grades.map((g, i) => (
                  <tr key={i} className="border-b border-slate-100">
                    <td className="p-2 font-bold text-slate-800">{g.subject}</td>
                    <td className="p-2">{g.q1}</td><td className="p-2">{g.q2}</td><td className="p-2">{g.q3}</td>
                    <td className="p-2 font-black text-indigo-700">{g.final}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </div>
      )}

      {/* Modal Sincronización */}
      {showSchoolAccessModal && (
        <div className="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl space-y-4">
            <h3 className="font-black text-slate-900 text-lg">Sincronizar SchoolAccess</h3>
            {saError && <p className="text-xs text-rose-600 bg-rose-50 p-2 rounded-lg">{saError}</p>}
            <form onSubmit={handleSyncSchoolAccess} className="space-y-3">
              <div>
                <label className="text-xs font-bold text-slate-700">Rango de Extracción (Deberes)</label>
                <select value={syncRange} onChange={(e: any) => setSyncRange(e.target.value)} className="w-full border rounded-xl p-2 text-sm mt-1">
                  <option value="semana">Solo la semana seleccionada</option>
                  <option value="mes">Mes completo</option>
                  <option value="año">Todo el año escolar</option>
                </select>
              </div>
              <div>
                <label className="text-xs font-bold text-slate-700">Fecha de Referencia</label>
                <input type="date" value={saSyncDate} onChange={(e) => setSaSyncDate(e.target.value)} className="w-full border rounded-xl p-2 text-sm mt-1" />
              </div>
              <input type="text" placeholder="Usuario" required value={saUser} onChange={(e) => setSaUser(e.target.value)} className="w-full border rounded-xl p-2 text-sm" />
              <input type="password" placeholder="Contraseña" required value={saPass} onChange={(e) => setSaPass(e.target.value)} className="w-full border rounded-xl p-2 text-sm" />
              
              <div className="flex justify-end gap-2 pt-2">
                <button type="button" onClick={() => setShowSchoolAccessModal(false)} className="px-4 py-2 font-bold text-slate-500">Cancelar</button>
                <button type="submit" disabled={saLoading} className="bg-sky-600 text-white font-bold px-5 py-2.5 rounded-xl disabled:opacity-50">
                  {saLoading ? 'Extrayendo...' : 'Iniciar Importación'}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}

