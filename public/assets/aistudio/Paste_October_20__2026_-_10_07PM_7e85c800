```typescript
import express from 'express';
import fetch from 'node-fetch';
import * as cheerio from 'cheerio';
import { createServer as createViteServer } from 'vite';

async function startServer() {
  const app = express();
  app.use(express.json());

  let activeSessionCookies = '';

  // 1. LOGIN ROUTE
  app.post('/api/school/login', async (req: any, res: any) => {
    try {
      const { username, password } = req.body;
      const loginUrl = 'https://crp.school-access.com/schoolaccess_internet/Login_inicial.asp';
      
      const params = new URLSearchParams({
        user: username,
        txtUser: username,
        username: username,
        pass: password,
        txtPass: password,
        password: password
      });

      const response = await fetch(loginUrl, {
        method: 'POST',
        body: params,
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)',
          'Referer': 'https://crp.school-access.com/schoolaccess_internet/'
        },
        redirect: 'manual' 
      });

      let cookiesStr = '';
      if (typeof (response.headers as any).raw === 'function') {
        const rawCookies = (response.headers as any).raw()['set-cookie'];
        if (rawCookies) {
          cookiesStr = rawCookies.map((c: string) => c.split(';')[0]).join('; ');
        }
      }

      if (!cookiesStr) return res.status(401).json({ success: false, error: 'Login fallido: No se recibieron cookies.' });
      
      activeSessionCookies = cookiesStr;
      res.json({ success: true, message: 'Conectado a SchoolAccess', cookies: activeSessionCookies });
    } catch (error: any) {
      res.status(500).json({ success: false, error: error.message });
    }
  });

  // 2. ASSIGNMENTS ROUTE (Soporta rangos amplios para "Todo el año")
  app.get('/api/school/assignments', async (req: any, res: any) => {
    try {
      if (!activeSessionCookies) return res.status(401).json({ success: false, error: 'No hay sesión activa.' });

      const { startDate, endDate } = req.query;
      let start = new Date();
      let end = new Date();

      if (startDate && endDate) {
        start = new Date(`${startDate}T12:00:00`);
        end = new Date(`${endDate}T12:00:00`);
      }

      const pad = (n: number) => String(n).padStart(2, '0');
      const formatDateStr = (d: Date) => `${pad(d.getMonth() + 1)}/${pad(d.getDate())}/${d.getFullYear()}`;

      const queryParams = new URLSearchParams({
        mes: String(start.getMonth() + 1),
        anio: String(start.getFullYear()),
        codigo_grupo: '535', 
        fecha_inicio: formatDateStr(start),
        fecha_fin: formatDateStr(end)
      });

      const targetUrl = `https://crp.school-access.com/schoolaccess_reports/std/std_rep_asignaciones_semanal.asp?${queryParams.toString()}`;
      
      const response = await fetch(targetUrl, {
        method: 'GET',
        headers: { 'Cookie': activeSessionCookies, 'User-Agent': 'Mozilla/5.0' }
      });

      const html = await response.text();
      if (html.includes('Login_inicial.asp')) return res.status(401).json({ success: false, error: 'La sesión expiró.' });

      const $ = cheerio.load(html);
      const assignments: any[] = [];
      let currentGroupDate = 'Sin fecha';

      $('.MainTable table.Grid tr').each((_, el) => {
        const $el =$(el);
        if ($el.hasClass('GroupCaption')) {
          currentGroupDate = $el.text().replace(/\n/g, '').trim();
        } else if ($el.hasClass('Row')) {
          const tds = $el.find('td');
          if (tds.length >= 3) {
            const subject = tds.eq(0).text().trim();
            const type = tds.eq(1).text().trim();
            const rawDescHtml = tds.eq(2).html() || '';
            const titleRaw = rawDescHtml.split('<br>')[0] || rawDescHtml.split('<br />')[0] || '';
            const title = cheerio.load(titleRaw).text().trim();
            
            let notes = `Tipo: ${type}`;
            if (rawDescHtml.includes('<b>Detalle:</b>')) {
              const detailHtml = rawDescHtml.split('<b>Detalle:</b>')[1];
              notes = cheerio.load(detailHtml).text().replace(/\s+/g, ' ').trim();
            }

            if (title && !title.toLowerCase().includes('grupo:')) {
              assignments.push({
                id: `school_${Date.now()}_${Math.random().toString(36).substr(2, 5)}`,
                subject, title, dueDate: currentGroupDate, 
                priority: type.toLowerCase().includes('ejercicio') ? 'Alta' : 'Media',
                notes: notes.substring(0, 100) + (notes.length > 100 ? '...' : ''),
                completed: false, source: 'SchoolAccess'
              });
            }
          }
        }
      });

      res.json({ success: true, count: assignments.length, data: assignments });
    } catch (error: any) {
      res.status(500).json({ success: false, error: error.message });
    }
  });

  // 3. SCHEDULE ROUTE (Horario de Clases Grid)
  app.get('/api/school/schedule', async (req: any, res: any) => {
    try {
      if (!activeSessionCookies) return res.status(401).json({ success: false, error: 'No hay sesión activa.' });

      const targetUrl = 'https://crp.school-access.com/schoolaccess_internet/estudiante_horario_clases_grid.asp';
      const response = await fetch(targetUrl, {
        headers: { 'Cookie': activeSessionCookies, 'User-Agent': 'Mozilla/5.0' }
      });
      const html = await response.text();
      const $ = cheerio.load(html);
      const classes: any[] = [];
      const days = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes'];
      const colors = ['blue', 'emerald', 'pink', 'amber', 'indigo', 'teal', 'purple'];

      // El ASP típicamente pone el horario en una tabla principal. Analizamos filas y celdas.
      $('table tr').each((rowIndex, row) => {
        if (rowIndex === 0) return; // Skip cabecera
        const timeSlot = $(row).find('td').eq(0).text().trim();
        if (!timeSlot || timeSlot.includes('Recreo')) return;

        $(row).find('td').each((colIndex, cell) => {
          if (colIndex === 0) return; // La columna 0 es la hora
          const content = $(cell).text().trim();
          if (content && content.length > 3) {
            classes.push({
              id: `class_${rowIndex}_${colIndex}`,
              day: days[colIndex - 1] || 'Lunes',
              time: timeSlot,
              subject: content.split('\n')[0] || content, // Asume que la materia es la primera línea
              classroom: 'Escuela', // Ajustar si el HTML provee el salón
              teacher: 'Profesor(a)',
              color: colors[(rowIndex + colIndex) % colors.length]
            });
          }
        });
      });

      res.json({ success: true, data: classes });
    } catch (error: any) {
      res.status(500).json({ success: false, error: error.message });
    }
  });

  // 4. GRADES ROUTE (Boletín de Calificaciones)
  app.get('/api/school/grades', async (req: any, res: any) => {
    try {
      if (!activeSessionCookies) return res.status(401).json({ success: false, error: 'No hay sesión activa.' });

      const targetUrl = 'https://crp.school-access.com/schoolaccess_internet/estudiante_boletin_calificaciones.asp';
      const response = await fetch(targetUrl, {
        headers: { 'Cookie': activeSessionCookies, 'User-Agent': 'Mozilla/5.0' }
      });
      const html = await response.text();
      const $ = cheerio.load(html);

      const gradesData = {
        grades: [] as any[],
        habits: [] as any[],
        attendance: [] as any[],
        observations: [] as string[]
      };

      // Extracción genérica de tablas del boletín
      $('table').each((i, table) => {
        const tableHtml = $(table).html() || '';
        // Detectar si es tabla de calificaciones
        if (tableHtml.toLowerCase().includes('materia') || tableHtml.toLowerCase().includes('asignatura')) {
          $(table).find('tr').each((j, row) => {
            if (j === 0) return;
            const tds = $(row).find('td');
            if (tds.length >= 2) {
              gradesData.grades.push({
                subject: tds.eq(0).text().trim(),
                q1: tds.eq(1).text().trim(),
                q2: tds.eq(2).text().trim() || '',
                q3: tds.eq(3).text().trim() || '',
                final: tds.last().text().trim()
              });
            }
          });
        }
        // Detectar Hábitos
        else if (tableHtml.toLowerCase().includes('hábitos') || tableHtml.toLowerCase().includes('actitudes')) {
          $(table).find('tr').each((j, row) => {
            if (j === 0) return;
            const tds = $(row).find('td');
            if (tds.length >= 2) {
              gradesData.habits.push({ name: tds.eq(0).text().trim(), evaluation: tds.eq(1).text().trim() });
            }
          });
        }
      });

      res.json({ success: true, data: gradesData });
    } catch (error: any) {
      res.status(500).json({ success: false, error: error.message });
    }
  });

  const vite = await createViteServer({ server: { middlewareMode: true, allowedHosts: true }, appType: 'spa' });
  app.use(vite.middlewares);
  app.listen(3000, '0.0.0.0', () => console.log('Server running on http://localhost:3000'));
}
startServer();

